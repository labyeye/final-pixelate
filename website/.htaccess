<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Force HTTPS + www
RewriteCond %{HTTP_HOST} !^www\.pixelatenest\.com$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.pixelatenest.com/$1 [L,R=301]

RewriteRule ^index\.html$ / [R=301,L]

# Strip .html extension (301 redirect)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html\ HTTP
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# === LEGACY REDIRECTS ===
RewriteRule ^videoediting$ /services/video-editing [R=301,L]
RewriteRule ^video-editing$ /services/video-editing [R=301,L]
RewriteRule ^video-ed$ /services/video-editing [R=301,L]
RewriteRule ^appdev$ /services/app-development [R=301,L]
RewriteRule ^app-dev$ /services/app-development [R=301,L]
RewriteRule ^webdev$ /services/web-development [R=301,L]
RewriteRule ^software-dev$ /services/software-development [R=301,L]
RewriteRule ^hosting-maintenance$ /services/hosting-maintenance [R=301,L]
RewriteRule ^detailed-services-digital$ /services/digital-marketing [R=301,L]
RewriteRule ^detailed-services-uiux$ /services/uiux-branding [R=301,L]
RewriteRule ^detailed-services$ /services/index.html [R=301,L]
RewriteRule ^detailed-services/video-editing/?$ /services/video-editing.html [R=301,L]
RewriteRule ^detailed-services/app-development/?$ /services/app-development.html [R=301,L]
RewriteRule ^detailed-services/web-development/?$ /services/web-development.html [R=301,L]
RewriteRule ^detailed-services/software-development/?$ /services/software-development.html [R=301,L]
RewriteRule ^detailed-services/(.*)$ /services/index.html [R=301,L]

# Legacy query-based service URLs — redirect to correct service pages
RewriteCond %{QUERY_STRING} (^|&)service=web-development(&|$) [NC]
RewriteRule ^detailed-services(\.html)?$ /services/web-development.html? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)service=app-development(&|$) [NC]
RewriteRule ^detailed-services(\.html)?$ /services/app-development.html? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)service=software-development(&|$) [NC]
RewriteRule ^detailed-services(\.html)?$ /services/software-development.html? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)service=video-editing(&|$) [NC]
RewriteRule ^detailed-services(\.html)?$ /services/video-editing.html? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)service=digital-marketing(&|$) [NC]
RewriteRule ^detailed-services(\.html)?$ /services/digital-marketing.html? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)service=uiux(&|$) [NC]
RewriteRule ^detailed-services(\.html)?$ /services/uiux-branding.html? [R=301,L]

# Redirect old page URLs to new locations
RewriteRule ^about$ /pages/about [R=301,L]
RewriteRule ^contact$ /pages/contact [R=301,L]
RewriteRule ^careers$ /pages/careers [R=301,L]
RewriteRule ^pricing$ /pages/pricing [R=301,L]
RewriteRule ^technologies$ /pages/technologies [R=301,L]
RewriteRule ^team-leadership$ /pages/team-leadership [R=301,L]
RewriteRule ^photography$ /pages/photography [R=301,L]
RewriteRule ^locations$ /pages/locations [R=301,L]
RewriteRule ^location$ /pages/locations [R=301,L]
RewriteRule ^state$ /pages/locations [R=301,L]
RewriteRule ^portfolio-details$ /pages/portfolio-details [R=301,L]
RewriteRule ^product$ /pages/product [R=301,L]

# Blog index.html → /blog/ (canonical is /blog/)
RewriteRule ^blog/index\.html$ /blog/ [R=301,L]

# Redirect old blog URLs
RewriteRule ^blog$ /blog/ [R=301,L]
RewriteRule ^blogs$ /blog/ [R=301,L]
RewriteRule ^blog-post$ /blog/ [R=301,L]

# Redirect old industry URLs
RewriteRule ^industry-ecommerce$ /industries/ecommerce [R=301,L]
RewriteRule ^industry-education$ /industries/education [R=301,L]
RewriteRule ^industry-logistics$ /industries/logistics [R=301,L]
RewriteRule ^industry-manufacturing$ /industries/manufacturing [R=301,L]
RewriteRule ^industry-realestate$ /industries/real-estate [R=301,L]
RewriteRule ^industry-travel$ /industries/travel [R=301,L]
RewriteRule ^industry-utilities$ /industries/utilities [R=301,L]
RewriteRule ^industry-healthcare$ /industries/ [R=301,L]
RewriteRule ^industry-finance$ /industries/ [R=301,L]
RewriteRule ^industry-media$ /industries/ [R=301,L]

# Search and other cleanup
RewriteRule ^search$ / [R=301,L]

# Redirect old legal URLs
RewriteRule ^cookie-policy$ /legal/cookie-policy [R=301,L]
RewriteRule ^privacy-policy$ /legal/privacy-policy [R=301,L]
RewriteRule ^refund-policy$ /legal/refund-policy [R=301,L]
RewriteRule ^terms-of-service$ /legal/terms-of-service [R=301,L]

# Other legacy redirects
RewriteRule ^works$ /pages/pricing [R=301,L]
RewriteRule ^features$ /pages/about [R=301,L]
RewriteRule ^team-members/(.*)$ /pages/about [R=301,L]
RewriteRule ^inner-pages/career$ /pages/careers [R=301,L]
RewriteRule ^inner-pages/(.*)$ / [R=301,L]
RewriteRule ^checkout$ /pages/contact [R=301,L]
RewriteRule ^api/(.*)$ - [R=410,L]

# Doorway page consolidation/redirection
RewriteRule ^factory-management-bihar$ /pages/locations.html [R=301,L]
RewriteRule ^factory-management-bihar/(.+)$ /locations/factory-management-bihar/$1 [R=301,L]
RewriteRule ^counter-billing-bihar\.html$ /pages/locations.html [R=301,L]
RewriteRule ^counter-billing-bihar$ /pages/locations.html [R=301,L]
# Special case: sharif vs bihar-sharif filename mismatch
RewriteRule ^counter-billing-bihar/counter-billing-sharif$ /locations/counter-billing-bihar/counter-billing-bihar-sharif.html [R=301,L]
RewriteRule ^counter-billing-bihar/counter-billing-sharif\.html$ /locations/counter-billing-bihar/counter-billing-bihar-sharif.html [R=301,L]
RewriteRule ^counter-billing-bihar/(.+)$ /locations/counter-billing-bihar/$1 [R=301,L]
RewriteRule ^school-crm-bihar$ /pages/locations.html [R=301,L]
RewriteRule ^school-crm-bihar/(.+)$ /locations/school-crm-bihar/$1 [R=301,L]
RewriteRule ^school-crm-muzaffarpur$ /locations/school-crm-muzaffarpur.html [R=301,L]

# State with city query string — redirect to locations hub
RewriteCond %{QUERY_STRING} city= [NC]
RewriteRule ^state(\.html)?$ /pages/locations.html? [R=301,L]

# Fix double slashes
RewriteCond %{THE_REQUEST} //
RewriteRule ^.*$ /$0 [R=301,L,NE]

# Extensionless URL handling — try appending .html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Directory index fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpg "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/gif "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/pdf "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType application/x-javascript "access plus 1 month"
ExpiresByType text/javascript "access plus 1 month"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresDefault "access plus 2 days"
</IfModule>

<IfModule mod_headers.c>
Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.google.com https://www.gstatic.com https://ajax.googleapis.com https://cdn.prod.website-files.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-src 'self' https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self';"
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set X-XSS-Protection "1; mode=block"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

Options -Indexes

<FilesMatch "^\.">
Order allow,deny
Deny from all
</FilesMatch>
